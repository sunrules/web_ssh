[Unit]
Description=WebSSH — Web-based SSH client with WebSocket terminal
Documentation=https://github.com/webssh
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/webssh
ExecStart=/opt/webssh/webssh -p 3400
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/webssh

[Install]
WantedBy=multi-user.target